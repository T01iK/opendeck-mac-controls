				"TriggerDescription": { "Push": "Toggle" }
			},
			"States": [{ "Image": "keys/controlcenter", "ShowTitle": false }],
			"SupportedInMultiActions": true
		},
		{
			"UUID": "com.t01ik.macoscontrols.keyboardbrightness",
			"Name": "Keyboard Brightness",
			"Tooltip": "Backlight of the built-in keyboard. On a dial: turn to adjust, press for preset.",
			"Icon": "icons/keyboardbrightness",
			"PropertyInspectorPath": "pi/level.html",
			"Controllers": ["Keypad", "Encoder"],
			"Encoder": {
				"layout": "$B1",
				"Icon": "icons/keyboardbrightness",
